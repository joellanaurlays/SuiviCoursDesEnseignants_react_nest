# Laisser vide en développement local pour utiliser le proxy Vite (/api).
# Renseigner une URL complète uniquement pour une API distante.
VITE_API_URL=


# Désactiver le mode prévisualisation (données statiques démo) :
# mettre "false" (ou supprimer la ligne) pour utiliser l'API réelle avec login.
VITE_ENABLE_LOCAL_PREVIEW=false
