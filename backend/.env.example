# Copier ce fichier vers .env, puis adapter les identifiants locaux.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/suivicours_db?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=suivicours_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Remplacer par une valeur aléatoire longue (par exemple : openssl rand -base64 48).
JWT_SECRET=remplacer-par-une-cle-aleatoire-longue-avant-utilisation
JWT_EXPIRATION=24h

PORT=3000
FRONTEND_URL=http://localhost:5173
