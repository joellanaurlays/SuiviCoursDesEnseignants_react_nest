generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  CHEF_SCOLARITE
  ADMINISTRATEUR
  RESPONSABLE_LICENCE
  RESPONSABLE_MASTER
  ENSEIGNANT
}

model Role {
  id          Int       @id @default(autoincrement())
  name        RoleName  @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  users       User[]

  @@map("roles")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  mentionId String?  @map("mention_id")
  cycles    String[] @default([])
  parcours  String?
  roleId    Int      @map("role_id")
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum Cycle {
  LICENCE
  MASTER
}

enum EtatEnseignement {
  NON_COMMENCE
  EN_COURS
  TERMINE
}

enum StatutSeance {
  PLANIFIEE
  REALISEE
  ANNULEE
}

enum ActionAuditSeance {
  CREATION
  DECLARATION_REALISEE
  REALISATION
  ANNULATION
  MODIFICATION
  CORRECTION
  SUPPRESSION
}

model Enseignement {
  id                  String           @id @default(cuid())
  matiereId           String
  enseignantId        String?          @map("enseignant_id")
  mentionId           String
  cycle               Cycle
  niveauId            String
  parcours            String
  semestreId          String
  anneeUniversitaireId String
  volumePrevu         Int
  heuresRealisees     Float            @default(0)
  progression         Float            @default(0)
  etat                EtatEnseignement @default(NON_COMMENCE)
  clotureAnticipee    Boolean          @default(false)
  motifCloture        String?
  dateCloture         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  seances             Seance[]

  @@index([enseignantId])
  @@index([mentionId, cycle])
  @@index([clotureAnticipee])
}

model Seance {
  id              String       @id @default(cuid())
  enseignementId  String
  dateSeance      DateTime
  heureDebut      String
  heureFin        String
  duree           Float
  contenuEnseigne String?
  salle           String?
  typeSeance      String?
  statut          StatutSeance @default(PLANIFIEE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  enseignement   Enseignement @relation(fields: [enseignementId], references: [id])

  @@index([enseignementId, dateSeance])
}

model JournalAuditSeance {
  id             String           @id @default(cuid())
  seanceId       String
  enseignementId String
  utilisateurId  String
  action         ActionAuditSeance
  motif          String?
  statutAvant    StatutSeance?
  statutApres    StatutSeance?
  valeursAvant   Json?
  valeursApres   Json?
  enseignantId   String
  mentionId      String
  cycle          Cycle
  parcours       String
  createdAt      DateTime         @default(now())

  @@index([seanceId])
  @@index([enseignementId])
  @@index([utilisateurId])
  @@index([enseignantId])
  @@index([createdAt])
}
