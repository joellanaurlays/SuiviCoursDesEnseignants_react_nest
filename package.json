{
  "name": "stage",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run start:frontend",
    "build": "npm run build:backend",
    "build:backend": "tsc -p backend/tsconfig.json",
    "start": "npm run start:prod",
    "start:dev": "ts-node -P backend/tsconfig.json backend/src/main.ts",
    "start:prod": "node backend/dist/main.js",
    "start:frontend": "npm run dev --prefix frontend",
    "db:demo": "node prisma/seed-cloture-demo.cjs",
    "db:demo:force": "node prisma/seed-cloture-demo.cjs --force",
    "db:demo:clean": "node prisma/seed-cloture-demo.cjs --clean",
    "db:parcours": "node prisma/seed-parcours.cjs",
    "db:demo:audit": "node prisma/seed-audit-demo.cjs",
    "db:reparer-suivi": "ts-node -P backend/tsconfig.json backend/src/maintenance/reparer-suivi.ts",
    "db:reparer-suivi:dry-run": "ts-node -P backend/tsconfig.json backend/src/maintenance/reparer-suivi.ts --dry-run",
    "db:verifier": "node backend/scripts/verifier-donnees-bdd.cjs",
    "api:verifier": "node backend/scripts/verifier-donnees-api.cjs",
    "prebuild:backend": "node -e \"require('fs').rmSync('backend/dist',{recursive:true,force:true})\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/client": "^5.22.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "next": "^16.3.3",
    "postcss": "^8.5.26",
    "prisma": "^5.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/jest": "^30.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jest": "^30.5.1",
    "react-router-dom": "^7.18.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "vite": "^8.2.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js && npm run db:reparer-suivi"
  }
}
